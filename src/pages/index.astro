---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { Picture } from "astro:assets";
import heroNailsImage from "../assets/hero-nails.jpg";
import { readSiteContent } from "../lib/db";

export const prerender = false;

const { services, workingHours, announcement } = await readSiteContent();
const dayNames = [
  "Domingo",
  "Lunes",
  "Martes",
  "Miércoles",
  "Jueves",
  "Viernes",
  "Sábado",
];
const schemaDayNames = [
  "Sunday",
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
];

const instagram = "https://www.instagram.com/valkyriasnailstudios/";
const whatsapp =
  "https://wa.me/541176290269?text=Hola%2C%20quiero%20reservar%20un%20turno%20en%20Valkyria%20Nail%20Studio";
const facebook = "https://www.facebook.com/valkyriasnailstudios/";
const tiktok = "https://www.tiktok.com/@valkyriasnailstudios";
const googleBusiness =
  "https://business.google.com/v/valkyrias-nails-studios/05882234067432442454/5bec/_?";
const directions =
  "https://www.google.com/maps/dir/?api=1&destination=Acoyte+81%2C+Buenos+Aires";
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const openGraphImageUrl = Astro.site
  ? new URL("/images/og-nails.jpg", Astro.site).href
  : undefined;

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["BeautySalon", "LocalBusiness"],
  "@id": canonicalUrl ? `${canonicalUrl}#business` : undefined,
  name: "Valkyria Nail Studio",
  description:
    "Salón de manicura en Caballito, Buenos Aires. Un espacio para embellecer tus manos, elegir tu próximo diseño y disfrutar de una buena charla.",
  url: canonicalUrl,
  image: openGraphImageUrl,
  telephone: "+541176290269",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Acoyte 81",
    addressLocality: "Buenos Aires",
    addressRegion: "Ciudad Autónoma de Buenos Aires",
    postalCode: "1405",
    addressCountry: "AR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -34.62176125,
    longitude: -58.4286208,
  },
  openingHoursSpecification: workingHours.map((hours) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: `https://schema.org/${schemaDayNames[hours.day]}`,
      opens: hours.opens,
      closes: hours.closes,
  })),
  areaServed: {
    "@type": "Place",
    name: "Caballito, Buenos Aires",
  },
  hasMap: "https://www.google.com/maps/place/Valkyrias+Nails+Studios/",
  sameAs: [instagram, facebook, tiktok, googleBusiness],
}).replace(/</g, "\\u003c");

const inspirationImages = [
  {
    src: "/images/IMG-20220218-WA0004.webp",
    alt: "Uñas en tonos turquesa con detalles decorativos",
    title: "Turquesa y detalles",
    style: "inspiration-card--large",
    width: 1079,
    height: 1494,
  },
  {
    src: "/images/IMG-20220218-WA0008.webp",
    alt: "Manicura en tonos oscuros con detalles decorativos",
    title: "Diseño en negro",
    style: "",
    width: 1050,
    height: 1400,
  },
  {
    src: "/images/IMG-20220218-WA0017.webp",
    alt: "Manicura en tonos claros con detalles sutiles",
    title: "Tonos suaves",
    style: "",
    width: 1291,
    height: 1600,
  },
];

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f4" />
    <meta
      name="description"
      content="Valkyria Nail Studio: manicura, uñas esculpidas y diseños en Caballito, Buenos Aires. Encontranos en Acoyte 81."
    />
    <meta property="og:title" content="Valkyria Nail Studio | Caballito" />
    <meta property="og:site_name" content="Valkyria Nail Studio" />
    <meta
      property="og:description"
      content="Manicura, uñas esculpidas y diseños reales en Caballito. Conocé Valkyria Nail Studio."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      openGraphImageUrl && (
        <>
          <meta property="og:image" content={openGraphImageUrl} />
          <meta property="og:image:secure_url" content={openGraphImageUrl} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content="Trabajo de manicura con uñas rosas y detalles plateados realizado en Valkyria Nail Studio"
          />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content="Valkyria Nail Studio | Caballito" />
          <meta
            name="twitter:description"
            content="Manicura, uñas esculpidas y diseños reales en Caballito. Conocé Valkyria Nail Studio."
          />
          <meta name="twitter:image" content={openGraphImageUrl} />
          <meta
            name="twitter:image:alt"
            content="Trabajo de manicura con uñas rosas y detalles plateados realizado en Valkyria Nail Studio"
          />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <title>Valkyria Nail Studio | Manicura en Caballito</title>
    <script type="application/ld+json" set:html={localBusinessSchema}></script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    {
      announcement.active && (
        <aside class="announcement-bar" aria-label="Anuncio del estudio">
          {announcement.href ? (
            <a href={announcement.href} target="_blank" rel="noreferrer">
              <span>{announcement.message}</span><span aria-hidden="true">↗</span>
            </a>
          ) : (
            <p>{announcement.message}</p>
          )}
        </aside>
      )
    }
    <header class="site-header" style={`top: ${announcement.active ? "40px" : "0"}`}>
      <a class="brand" href="#inicio" aria-label="Valkyria Nail Studio, inicio">
        <span class="brand-mark" aria-hidden="true">V</span>
        <span class="brand-name">Valkyria <small>Nail Studio</small></span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span></span><span></span>
      </button>
      <nav class="primary-nav" id="primary-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#inspiracion">Inspiración</a>
        <a href="#nosotras">Quiénes somos</a>
        <a href="#cuidado">Cuidado e higiene</a>
        <a href="#visitanos">Encontranos</a>
        <a class="nav-cta" href={whatsapp} target="_blank" rel="noreferrer">
          Reservá tu turno <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero section-wrap" id="inicio">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> MANICURA · CABALLITO</p>
          <h1>Manos que hablan <em>de vos.</em></h1>
          <p class="hero-description">
            Un espacio para embellecer tus manos, elegir tu próximo diseño y
            disfrutar de una buena charla.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href={whatsapp} target="_blank" rel="noreferrer">
              Quiero mi turno <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#servicios">Conocé el estudio <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof">
            <div class="rating-stars" aria-label="5 estrellas">★★★★★</div>
            <p><strong>4,9 de 5</strong><span> · 14 opiniones en Google</span></p>
          </div>
        </div>

        <div class="hero-visual reveal">
          <div class="hero-image-frame">
            <Picture
              src={heroNailsImage}
              alt="Manicura con uñas oscuras y detalles carey"
              formats={["avif", "webp"]}
              widths={[360, 640, 960]}
              sizes="(max-width: 680px) calc(100vw - 54px), (max-width: 900px) 48vw, 485px"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <div class="hero-image-shade"></div>
            <div class="image-caption">
              <span>UN RATITO PARA VOS</span>
              <span class="caption-star" aria-hidden="true">✳</span>
            </div>
          </div>
          <div class="hero-sticker" aria-label="Atención en Caballito">
            <span>HECHO CON</span>
            <strong>♡</strong>
            <span>EN CABALLITO</span>
          </div>
          <div class="hero-side-note">TU ESTILO, EN CADA DETALLE</div>
        </div>
        <a class="scroll-cue" href="#servicios"><span></span> DESLIZÁ PARA DESCUBRIR</a>
      </section>

      <div class="ticker" aria-label="Valkyria Nail Studio, un espacio para vos">
        <div class="ticker-track" aria-hidden="true">
          {
            Array.from({ length: 4 }).map(() => (
              <span>Un espacio para vos</span>
              <i>✳</i>
              <span>Manos con personalidad</span>
              <i>✳</i>
              <span>Tu momento Valkyria</span>
              <i>✳</i>
            ))
          }
        </div>
      </div>

      <section class="services section-wrap section-space" id="servicios">
        <div class="section-heading reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> LO QUE HACEMOS</p>
          <div class="heading-row">
            <h2>Un mimo para tus manos.<br /><em>Un plan para vos.</em></h2>
            <p class="section-intro">
              Cada visita tiene su propio ritmo. Contanos qué tenés en mente y
              lo hacemos realidad juntas.
            </p>
          </div>
        </div>
        <div class="service-grid">
          {
            services.map((service, index) => (
              <article class="service-card reveal">
                <div class="service-top">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span class="service-flower" aria-hidden="true">✳</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <strong class="service-price">{service.price}</strong>
                <a href={whatsapp} target="_blank" rel="noreferrer" aria-label={`Consultar por ${service.title}`}>
                  Consultanos <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="inspiration section-space" id="inspiracion">
        <div class="section-wrap">
          <div class="section-heading inspiration-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> TRABAJOS DEL ESTUDIO</p>
            <div class="heading-row">
              <h2>Un color, una idea.<br /><em>Algo muy tuyo.</em></h2>
              <p class="section-intro">
                Guardá tus favoritos y traelos a tu turno. Cada diseño se
                adapta a vos.
              </p>
            </div>
          </div>
          <div class="inspiration-grid">
            {
              inspirationImages.map((image, index) => (
                <figure class={`inspiration-card ${image.style} reveal`}>
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <span>TRABAJO 0{index + 1}</span>
                    <strong>{image.title}</strong>
                  </figcaption>
                </figure>
              ))
            }
          </div>
          <div class="inspiration-footer">
            <p class="inspiration-note">
              Una selección de trabajos realizados en el estudio. Cada diseño
              se adapta a tu estilo.
            </p>
            <a class="text-link" href={instagram} target="_blank" rel="noreferrer">
              Ver Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="about section-wrap section-space" id="nosotras">
        <div class="founder-card reveal">
          <img
            class="founder-card-photo"
            src="/images/susana.webp"
            alt="Susana Delgado, fundadora y manicurista de Valkyria Nail Studio"
            width="1200"
            height="1600"
            loading="lazy"
            decoding="async"
          />
          <span class="founder-card-overline">V · N · S</span>
          <span class="founder-card-caption">FUNDADORA & MANICURISTA</span>
          <strong>Susana<br /><em>Delgado</em></strong>
          <span class="founder-card-years">+10 <small>AÑOS DE EXPERIENCIA</small></span>
        </div>
        <div class="about-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> SOBRE EL ESTUDIO</p>
          <h2>Más de diez años<br /><em>cuidando cada detalle.</em></h2>
          <p>
            Soy Susana Delgado, fundadora de Valkyria Nail Studio. Hace más
            de diez años que me dedico al cuidado de las uñas, con la misma
            pasión por los detalles y por hacer que cada persona se sienta
            cómoda.
          </p>
          <p>
            Creé Valkyria Nail Studio como un espacio para embellecer tus manos y llevarte
            también algo que nos encanta compartir: una buena charla.
          </p>
          <a class="text-link" href={googleBusiness} target="_blank" rel="noreferrer">
            Conocé la experiencia de nuestras clientas <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link about-care-link" href="#cuidado">
            Conocé nuestras políticas de cuidado e higiene <span aria-hidden="true">↓</span>
          </a>
          <div class="about-detail">
            <span class="about-detail-number">4,9<span>/5</span></span>
            <span class="about-detail-copy">La experiencia Valkyria<br />según nuestras clientas</span>
          </div>
          <figure class="studio-photo">
            <img
              src="/images/fondo.webp"
              alt="Interior de Valkyria Nail Studio con la mesa de manicura y exhibición de esmaltes"
              width="1200"
              height="1600"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span>NUESTRO ESPACIO</span>
              <strong>Te esperamos en Caballito</strong>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="care section-space" id="cuidado">
        <div class="section-wrap">
          <div class="section-heading care-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> CUIDADO, HIGIENE Y POLÍTICAS</p>
            <div class="heading-row">
              <h2>Tu tranquilidad<br /><em>también importa.</em></h2>
              <p class="section-intro">
                Conocé cómo cuidamos la higiene y organizamos cada turno antes
                de visitarnos.
              </p>
            </div>
          </div>
          <div class="care-grid">
            <article class="care-card reveal">
              <span class="care-number">01</span>
              <span class="care-icon" aria-hidden="true">✳</span>
              <h3>Higiene, sin dudas</h3>
              <p>
                Esterilizamos los equipos y usamos materiales descartables para
                cuidar la higiene en cada servicio.
              </p>
            </article>
            <article class="care-card reveal">
              <span class="care-number">02</span>
              <span class="care-icon" aria-hidden="true">◷</span>
              <h3>Señas y cancelaciones</h3>
              <p>
                Al solicitar el turno, pedimos una seña del 30% que no es
                reembolsable. Para cancelar, avisanos con 24 horas de
                anticipación.
              </p>
            </article>
            <article class="care-card reveal">
              <span class="care-number">03</span>
              <span class="care-icon" aria-hidden="true">♡</span>
              <h3>¿Vas a llegar tarde?</h3>
              <p>Contamos con una tolerancia de hasta 30 minutos.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="reviews section-space" id="opiniones">
        <div class="section-wrap">
          <div class="section-heading reviews-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> LO CUENTAN ELLAS</p>
            <div class="heading-row">
              <h2>Una buena experiencia<br /><em>se comparte.</em></h2>
              <div class="reviews-rating">
                <span class="reviews-stars" aria-label="5 estrellas">★★★★★</span>
                <strong>4,9 <span>/ 5</span></strong>
                <span>14 opiniones públicas en Google</span>
              </div>
            </div>
          </div>
          <div class="review-grid">
            <article class="review-card reveal">
              <span class="review-quote-mark" aria-hidden="true">“</span>
              <div class="review-stars" aria-label="5 estrellas">★★★★★</div>
              <blockquote>
                Me hago las manos hace un montón y JAMÁS me habían quedado tan
                hermosas prolijas y cuidadas. No veo la hora de mi próximo
                turno para que haga otro arte maravilloso en mis manos.
              </blockquote>
              <div class="review-credit">
                <span class="review-avatar" aria-hidden="true">F</span>
                <span><strong>Fernanda</strong><small>Opinión publicada en Google</small></span>
                <span class="google-g" aria-label="Google">G</span>
              </div>
            </article>
            <article class="review-card reveal">
              <span class="review-quote-mark" aria-hidden="true">“</span>
              <div class="review-stars" aria-label="5 estrellas">★★★★★</div>
              <blockquote>
                Las chicas al toque me dieron turno y me dejaron super bien las
                manos y los pies. Volveré.
              </blockquote>
              <div class="review-credit">
                <span class="review-avatar" aria-hidden="true">S</span>
                <span><strong>Sol</strong><small>Opinión publicada en Google</small></span>
                <span class="google-g" aria-label="Google">G</span>
              </div>
            </article>
          </div>
          <a class="reviews-link" href={googleBusiness} target="_blank" rel="noreferrer">
            Leer opiniones en Google <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="visit section-wrap section-space" id="visitanos">
        <div class="visit-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> TE ESPERAMOS</p>
          <h2>Nos encontramos<br /><em>en Caballito.</em></h2>
          <div class="visit-info">
            <div class="visit-info-icon" aria-hidden="true">⌖</div>
            <div>
              <strong>Acoyte 81</strong>
              <span>Caballito · Buenos Aires</span>
              <a href={directions} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <section class="schedule-card" aria-labelledby="schedule-title">
            <div class="schedule-heading">
              <span class="schedule-icon" aria-hidden="true">◷</span>
              <div>
                <h3 id="schedule-title">Horario de atención</h3>
                <span>Solo con reserva previa</span>
              </div>
              <span class="schedule-status"><span></span> CON TURNO</span>
            </div>
            <dl class="schedule-list">
              {
                workingHours.length > 0 ? (
                  workingHours.map((hours) => (
                    <div class="schedule-row">
                      <dt>{dayNames[hours.day]}</dt>
                      <dd>
                        <time datetime={hours.opens}>{hours.opens}</time>
                        <span aria-hidden="true">—</span>
                        <time datetime={hours.closes}>{hours.closes}</time>
                      </dd>
                    </div>
                  ))
                ) : (
                  <div class="schedule-row schedule-row--empty">
                    <dt>Horarios a coordinar</dt>
                    <dd>Consultanos por WhatsApp</dd>
                  </div>
                )
              }
            </dl>
            <a class="schedule-link" href={whatsapp} target="_blank" rel="noreferrer">
              Consultá disponibilidad <span aria-hidden="true">↗</span>
            </a>
          </section>
          <a class="button button-dark visit-button" href={whatsapp} target="_blank" rel="noreferrer">
            Reservá por WhatsApp <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="map-card reveal">
          <iframe
            title="Mapa de Valkyria Nail Studio en Acoyte 81, Caballito"
            src="https://maps.google.com/maps?q=Acoyte%2081%2C%20Caballito%2C%20Buenos%20Aires&z=15&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a class="map-label" href={directions} target="_blank" rel="noreferrer">
            <span class="map-dot"></span>
            <span><strong>Valkyria Nail Studio</strong><small>Acoyte 81 · Caballito</small></span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="faq section-space" id="preguntas">
        <div class="section-wrap">
          <div class="section-heading faq-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> ANTES DE TU TURNO</p>
            <div class="heading-row">
              <h2>Todo claro antes<br /><em>de venir.</em></h2>
              <p class="section-intro">
                ¿Tenés otra consulta? Escribinos por Instagram y te ayudamos
                a encontrar tu momento.
              </p>
            </div>
          </div>
          <div class="faq-list">
            <details class="faq-item reveal">
              <summary>¿Con cuánta anticipación conviene reservar?</summary>
              <p>
                Los turnos son con reserva y sujetos a disponibilidad.
                Escribinos por WhatsApp o Instagram apenas tengas tu fecha en mente para
                consultar los próximos horarios.
              </p>
            </details>
            <details class="faq-item reveal">
              <summary>¿Hacen kapping y esculpidas en gel o acrílico?</summary>
              <p>
                Trabajamos uñas esculpidas en acrílico, gel y polygel.
                Consultanos por kapping y te confirmamos disponibilidad por mensaje al
                coordinar tu turno.
              </p>
            </details>
            <details class="faq-item reveal">
              <summary>¿Piden seña? ¿Cómo es la política de cancelación?</summary>
              <p>
                Al solicitar el turno, pedimos una seña del 30% que no es
                reembolsable. Para cancelar, avisanos con 24 horas de
                anticipación.
              </p>
            </details>
            <details class="faq-item reveal">
              <summary>¿Qué tolerancia hay si llego tarde?</summary>
              <p>Contamos con una tolerancia de hasta 30 minutos.</p>
            </details>
            <details class="faq-item reveal">
              <summary>¿Qué medios de pago aceptan?</summary>
              <p>
                Aceptamos efectivo, transferencia y Mercado Pago.
              </p>
            </details>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="final-cta-inner reveal">
