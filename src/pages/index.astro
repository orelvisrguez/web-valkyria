  .review-card blockquote { position: relative; z-index: 1; min-height: 76px; margin: 0 0 22px; font-family: var(--serif); font-size: 17px; line-height: 1.65; }
  .review-credit { display: flex; align-items: center; gap: 11px; padding-top: 14px; border-top: 1px solid var(--line); }
  .review-avatar { display: grid; width: 31px; height: 31px; flex: 0 0 31px; place-items: center; border-radius: 50%; background: var(--blush); color: var(--rose); font-family: var(--serif); font-size: 15px; }
  .review-credit > span:nth-child(2) { display: flex; flex: 1; flex-direction: column; gap: 3px; }
  .review-credit strong { font-size: 9px; }
  .review-credit small { color: var(--muted); font-size: 8px; }
  .google-g { color: #4285f4; font-family: Arial, sans-serif; font-size: 17px; font-weight: 700; }
  .reviews-link { display: inline-flex; align-items: center; gap: 12px; margin-top: 26px; padding-bottom: 5px; border-bottom: 1px solid rgba(255, 248, 241, .4); color: #fff8f1; font-size: 10px; font-weight: 600; transition: color .2s ease; }
  .reviews-link:hover { color: #e8cdb5; }

  .visit { display: grid; grid-template-columns: .87fr 1.13fr; align-items: center; gap: 8%; }
  .visit-copy .eyebrow { margin-bottom: 23px; }
  .visit-copy h2 { margin-bottom: 35px; font-size: clamp(42px, 4.7vw, 58px); }
  .visit-info { display: flex; gap: 16px; margin: 0 0 22px; }
  .visit-info-icon { display: grid; width: 36px; height: 36px; flex: 0 0 36px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--rose); font-size: 18px; }
  .visit-info > div:last-child { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; }
  .visit-info strong { font-size: 11px; }
  .visit-info span { color: var(--muted); font-size: 10px; }
  .visit-info a { margin-top: 4px; color: var(--rose); font-size: 9px; font-weight: 700; }
  .schedule-card { margin: 0 0 16px; padding: 20px; border: 1px solid var(--line); background: linear-gradient(145deg, #fffdfa, #f8f1ec); box-shadow: 0 12px 30px rgba(72, 39, 43, .06); }
  .schedule-heading { display: flex; align-items: center; gap: 12px; padding-bottom: 15px; border-bottom: 1px solid var(--line); }
  .schedule-icon { display: grid; width: 40px; height: 40px; flex: 0 0 40px; place-items: center; border-radius: 50%; background: var(--rose); color: #fff8f1; font-size: 21px; }
  .schedule-heading > div { display: flex; flex: 1; flex-direction: column; gap: 4px; }
  .schedule-heading h3 { margin: 0; font-family: var(--serif); font-size: 17px; font-weight: 500; }
  .schedule-heading > div > span { color: var(--muted); font-size: 9px; }
  .schedule-status { display: inline-flex; align-items: center; gap: 6px; color: #52705c; font-size: 7px; font-weight: 700; letter-spacing: .8px; white-space: nowrap; }
  .schedule-status > span { width: 6px; height: 6px; border-radius: 50%; background: #699475; box-shadow: 0 0 0 3px rgba(105, 148, 117, .12); }
  .schedule-list { margin: 0; padding: 3px 0; }
  .schedule-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; border-bottom: 1px solid rgba(230, 221, 214, .72); }
  .schedule-row:last-child { border-bottom: 0; }
  .schedule-row dt { color: var(--muted); font-size: 11px; font-weight: 500; }
  .schedule-row dd { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--ink); font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .schedule-row dd > span { color: var(--gold); font-size: 10px; }
  .schedule-row--empty dd { color: var(--muted); font-size: 10px; font-weight: 500; }
  .schedule-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; color: var(--rose); font-size: 9px; font-weight: 700; }
  .schedule-link:hover { color: var(--rose-deep); }
  .schedule-link:focus-visible { outline: 2px solid var(--rose); outline-offset: 4px; }
  .visit-button { margin-top: 12px; }
  .map-card { position: relative; height: 460px; overflow: hidden; background: #e8e1da; }
  .map-card iframe { width: 100%; height: 100%; border: 0; filter: saturate(.72) contrast(.94); }
  .map-label { position: absolute; right: 15px; bottom: 15px; left: 15px; display: flex; align-items: center; gap: 12px; padding: 15px 17px; background: var(--paper); box-shadow: 0 9px 28px rgba(48, 35, 38, .12); }
  .map-dot { width: 9px; height: 9px; flex: 0 0 9px; border-radius: 50%; background: var(--rose); box-shadow: 0 0 0 4px #f0e2dc; }
  .map-label > span:nth-child(2) { display: flex; flex: 1; flex-direction: column; gap: 4px; }
  .map-label strong { font-size: 10px; }
  .map-label small { color: var(--muted); font-size: 9px; }
  .map-label > span:last-child { color: var(--rose); }

  .faq { background: #f5eee9; }
  .faq-heading { margin-bottom: 34px; }
  .faq-list { max-width: 860px; margin-left: auto; border-top: 1px solid #ded2cb; }
  .faq-item { border-bottom: 1px solid #ded2cb; }
  .faq-item summary { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 21px 4px; cursor: pointer; font-family: var(--serif); font-size: 19px; line-height: 1.4; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { display: grid; width: 27px; height: 27px; flex: 0 0 27px; place-items: center; border: 1px solid #d5c6be; border-radius: 50%; color: var(--rose); content: "+"; font-family: var(--sans); font-size: 16px; transition: transform .2s ease, background .2s ease; }
  .faq-item[open] summary::after { background: white; transform: rotate(45deg); }
  .faq-item summary:focus-visible { outline: 2px solid var(--rose); outline-offset: 3px; }
  .faq-item p { max-width: 700px; margin: -4px 44px 21px 4px; color: var(--muted); font-size: 11px; line-height: 1.9; }

  .final-cta { overflow: hidden; padding: 90px 24px 95px; background: #f1e4dc; }
  .final-cta-inner { position: relative; width: min(1200px, 100%); margin-inline: auto; text-align: center; }
  .final-cta .eyebrow { justify-content: center; }
  .final-cta h2 { margin-bottom: 27px; font-size: clamp(48px, 6vw, 72px); }
  .button-light { background: var(--paper); color: var(--rose); }
  .button-light:hover { background: white; }
  .final-sparkle { position: absolute; top: 10%; right: 10%; color: var(--gold); font-size: 55px; }

  .site-footer { padding: 42px max(48px, calc((100vw - 1200px) / 2)) 104px; background: #302326; color: #fbf4ee; }
  .footer-main { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding-bottom: 34px; }
  .footer-brand .brand-mark { border-color: #b98d6a; color: #ecd4be; }
  .footer-brand .brand-name small { color: #cdbbb4; }
  .footer-main > p { margin: 0; color: #cdbbb4; font-size: 10px; line-height: 1.8; }
  .social-links { display: flex; gap: 22px; }
  .social-links a, .footer-bottom { font-size: 9px; }
  .social-links a { color: #f5e8df; }
  .social-links a:hover, .footer-bottom a:hover { color: #e5ba95; }
  .social-links span, .footer-bottom a span { color: #d5ad84; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 15px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, .14); color: #bdaeb0; }
  .footer-heart { color: #d49c9e; }

  .floating-booking { position: fixed; z-index: 15; right: 24px; bottom: calc(20px + env(safe-area-inset-bottom)); display: inline-flex; min-height: 56px; align-items: center; gap: 14px; padding: 0 19px; background: var(--rose); box-shadow: 0 10px 30px rgba(48, 24, 34, .24); color: white; font-size: 11px; font-weight: 700; transition: background .2s ease, transform .2s ease, box-shadow .2s ease; }
  .floating-booking:hover { background: var(--rose-deep); box-shadow: 0 13px 34px rgba(48, 24, 34, .32); transform: translateY(-3px); }
  .floating-booking:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .floating-booking-detail { padding-left: 13px; border-left: 1px solid rgba(255, 255, 255, .42); color: #f1dcd7; font-size: 9px; font-weight: 500; }
  .floating-booking-arrow { color: #e9c5a5; font-size: 16px; }

  .reveal { opacity: 1; transform: none; }
  .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s cubic-bezier(.2, .7, .2, 1); }
  .js .reveal.is-visible { opacity: 1; transform: translateY(0); }
  .service-card:nth-child(2), .care-card:nth-child(2), .review-card:nth-child(2), .inspiration-card:nth-child(2) { transition-delay: .08s; }
  .service-card:nth-child(3), .care-card:nth-child(3), .inspiration-card:nth-child(3) { transition-delay: .16s; }

  @media (max-width: 900px) {
    .section-wrap { width: min(100% - 56px, 720px); }
    .site-header { min-height: 74px; padding-inline: 28px; }
    .primary-nav { gap: 18px; font-size: 11px; }
    .nav-cta { padding: 11px 12px; }
    .hero { min-height: 590px; gap: 4%; }
    .hero h1 { font-size: clamp(54px, 7vw, 68px); }
    .hero-image-frame { height: 420px; }
    .hero-visual { padding-right: 12px; }
    .hero-sticker { right: -14px; }
    .section-space { padding-block: 94px; }
    .inspiration-grid { height: 380px; }
    .about { gap: 7%; }
    .founder-card { min-height: 390px; padding: 38px; }
    .founder-card-overline { top: 31px; left: 30px; }
    .founder-card > strong { font-size: clamp(42px, 5vw, 51px); }
    .care-grid { gap: 11px; }
    .care-card { padding-inline: 18px; }
    .care-card h3 { font-size: 20px; }
    .care-card p { font-size: 9px; }
    .visit { gap: 5%; }
    .map-card { height: 400px; }
    .site-footer { padding-inline: 28px; }
  }

  @media (max-width: 680px) {
    html { scroll-padding-top: 75px; }
    .section-wrap { width: calc(100% - 40px); }
    .section-space { padding-block: 75px; }
    .site-header { min-height: 70px; padding-inline: 20px; }
    .brand-mark { width: 35px; height: 35px; font-size: 22px; }
    .brand-name { font-size: 18px; }
    .menu-toggle { display: flex; width: 40px; height: 40px; flex-direction: column; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--line); background: transparent; cursor: pointer; }
    .menu-toggle span { width: 16px; height: 1px; background: var(--ink); transition: transform .2s ease; }
    .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .primary-nav { position: absolute; top: 69px; right: 0; left: 0; display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 8px 20px 20px; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: 0 16px 22px rgba(48, 35, 38, .08); opacity: 0; pointer-events: none; visibility: hidden; transform: translateY(-8px); transition: opacity .2s ease, transform .2s ease; }
    .primary-nav.is-open { opacity: 1; pointer-events: auto; visibility: visible; transform: translateY(0); }
    .primary-nav > a:not(.nav-cta) { padding: 14px 0; border-bottom: 1px solid var(--line); }
    .primary-nav .nav-cta { justify-content: space-between; margin-top: 15px; }
    .hero { min-height: 0; grid-template-columns: 1fr; gap: 42px; padding-block: 58px 72px; }
    .hero-copy { padding: 0; }
    .eyebrow { margin-bottom: 19px; font-size: 8px; }
    .hero h1 { max-width: 450px; margin-bottom: 19px; font-size: clamp(53px, 12vw, 72px); letter-spacing: -2.6px; }
    .hero-description { max-width: 410px; font-size: 13px; }
    .hero-proof { margin-top: 30px; }
    .hero-visual { width: min(100% - 14px, 440px); justify-self: center; padding: 0 15px 18px 0; }
    .hero-image-frame { height: min(112vw, 440px); }
    .hero-sticker { right: -9px; bottom: 48px; width: 88px; height: 88px; }
    .hero-sticker strong { font-size: 25px; }
    .hero-side-note { right: -19px; }
    .scroll-cue { bottom: 17px; }
    .ticker { padding-block: 16px; }
    .ticker-track { gap: 19px; }
    .ticker-track span { font-size: 16px; }
    .section-heading { margin-bottom: 34px; }
    .heading-row { align-items: flex-start; flex-direction: column; gap: 17px; }
    h2 { font-size: clamp(39px, 10vw, 51px); }
    .section-intro { max-width: 410px; font-size: 11px; }
    .service-grid { grid-template-columns: 1fr; gap: 11px; }
    .service-card { min-height: 0; padding: 23px; }
    .service-card h3 { margin-top: 20px; font-size: 25px; }
    .service-card p { min-height: 0; margin-bottom: 14px; }
    .service-price { margin-bottom: 13px; }
    .inspiration-heading { margin-bottom: 30px; }
    .inspiration-grid { height: auto; grid-template-columns: 1fr 1fr; grid-template-rows: 260px 220px; gap: 10px; }
    .inspiration-card--large { grid-column: 1 / -1; }
    .inspiration-card figcaption { right: 14px; bottom: 14px; left: 14px; }
    .inspiration-card figcaption strong { font-size: 18px; }
    .inspiration-note { font-size: 8px; text-align: left; }
    .about { grid-template-columns: 1fr; gap: 43px; }
    .founder-card { width: min(100% - 14px, 420px); min-height: 360px; padding: 36px; }
    .founder-card-overline { top: 29px; left: 28px; }
    .founder-card > strong { font-size: 48px; }
    .about-copy h2 { font-size: clamp(39px, 9.5vw, 49px); }
    .care-grid { grid-template-columns: 1fr; gap: 11px; }
    .care-card { min-height: 0; padding: 23px; }
    .care-card h3 { margin-top: 24px; font-size: 22px; }
    .care-card p { min-height: 0; margin-bottom: 15px; font-size: 10px; }
    .inspiration-footer { align-items: flex-start; flex-direction: column; }
    .review-grid { grid-template-columns: 1fr; }
    .review-card { min-height: 0; padding: 24px 22px 18px; }
    .review-card blockquote { min-height: 0; font-size: 16px; }
    .visit { grid-template-columns: 1fr; gap: 38px; }
    .visit-copy h2 { margin-bottom: 28px; font-size: clamp(43px, 10vw, 54px); }
    .schedule-card { padding: 17px; }
    .schedule-row { min-height: 45px; }
    .schedule-row dt { font-size: 10px; }
    .schedule-row dd { gap: 6px; font-size: 11px; }
    .map-card { height: 360px; }
    .faq-item summary { padding-block: 18px; font-size: 17px; }
    .faq-item p { margin-right: 28px; }
    .final-cta { padding-block: 76px; }
    .final-cta .eyebrow { font-size: 7px; letter-spacing: 1.5px; }
    .final-cta h2 { font-size: clamp(48px, 12vw, 64px); }
    .final-sparkle { top: -22px; right: 2%; font-size: 34px; }
    .site-footer { padding: 34px 20px 94px; }
    .footer-main { align-items: flex-start; flex-direction: column; gap: 23px; padding-bottom: 25px; }
    .footer-main > p { font-size: 10px; }
    .social-links { flex-wrap: wrap; gap: 18px; }
    .footer-bottom { flex-wrap: wrap; font-size: 8px; }
    .footer-bottom span:nth-child(2) { display: none; }
    .floating-booking { right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); left: 12px; min-height: 53px; justify-content: center; gap: 12px; padding-inline: 14px; }
  }

  :root {
    --paper: #fcfaf7;
    --ink: #302326;
    --muted: #75676a;
    --rose: #792c42;
    --rose-deep: #48212d;
    --gold: #b98d65;
    --line: #e8dfd8;
    --blush: #f0e2dc;
  }

  body {
    background:
      radial-gradient(ellipse at 82% 13%, rgba(233, 215, 205, .2), transparent 31rem),
      var(--paper);
    letter-spacing: .005em;
  }

  .section-wrap { width: min(1280px, calc(100% - 112px)); }
  .section-space { padding-block: clamp(104px, 11vw, 156px); }
  .site-header {
    min-height: 88px;
    padding-inline: max(56px, calc((100vw - 1280px) / 2));
    background: rgba(252, 250, 247, .88);
    border-bottom-color: rgba(72, 33, 45, .09);
  }
  .brand { gap: 13px; }
  .brand-mark {
    width: 43px;
    height: 43px;
    border-color: rgba(185, 141, 101, .8);
    background: rgba(255, 255, 255, .55);
  }
  .brand-name { font-size: 21px; }
  .primary-nav { gap: clamp(18px, 2.2vw, 32px); font-size: 11px; }
  .nav-cta { padding: 14px 19px; border-color: rgba(121, 44, 66, .55); }

  .hero {
    min-height: min(760px, calc(100svh - 88px));
    grid-template-columns: minmax(0, 1.04fr) minmax(0, .96fr);
    gap: clamp(42px, 7vw, 104px);
    padding-block: 72px 96px;
  }
  .hero-copy { padding-bottom: 0; }
  .hero .eyebrow { margin-bottom: 30px; }
  .hero h1 {
    max-width: 650px;
    margin-bottom: 27px;
    font-size: clamp(68px, 7.6vw, 108px);
    letter-spacing: -.065em;
    line-height: .91;
  }
  .hero-description { max-width: 420px; margin-bottom: 32px; font-size: 15px; line-height: 1.85; }
  .hero-actions { gap: 28px; }
  .button { min-height: 56px; padding-inline: 24px; font-size: 11px; letter-spacing: .025em; }
  .button-dark { box-shadow: 0 10px 24px rgba(72, 33, 45, .12); }
  .hero-proof {
    gap: 15px;
    margin-top: 40px;
    padding-top: 21px;
    border-top: 1px solid rgba(72, 33, 45, .12);
  }
  .hero-proof p { font-size: 10px; }
  .hero-visual { max-width: 530px; padding: 0 28px 30px 0; }
  .hero-image-frame {
    height: clamp(460px, 43vw, 600px);
    border-radius: 48% 48% 3px 3px / 34% 34% 3px 3px;
    box-shadow: 0 26px 70px rgba(66, 42, 43, .14);
  }
  .hero-image-frame::before { inset: 14px; border-radius: inherit; }
  .hero-image-frame img { object-position: center 42%; }
  .hero-image-shade { inset: 48% 0 0; }
  .image-caption { right: 38px; bottom: 36px; left: 38px; }
  .hero-sticker {
    right: -2px;
    bottom: 56px;
    width: 116px;
    height: 116px;
    border: 1px solid rgba(255, 248, 241, .56);
    outline: 1px solid rgba(121, 44, 66, .36);
    outline-offset: 5px;
    background: linear-gradient(145deg, #87384e, #652439);
  }
  .hero-side-note { right: -40px; }
  .scroll-cue { bottom: 30px; letter-spacing: 1.2px; }

  .ticker { padding-block: 21px; background: var(--rose-deep); }
  .ticker-track { gap: 34px; }
  .ticker-track span { font-size: 20px; }

  .section-heading { margin-bottom: 58px; }
  .section-heading .eyebrow { margin-bottom: 25px; }
  h2 { font-size: clamp(44px, 5vw, 66px); letter-spacing: -.045em; line-height: 1.04; }
  .heading-row { gap: 64px; }
  .section-intro { max-width: 360px; font-size: 13px; line-height: 1.9; }
  .services { padding-top: 145px; }
  .service-grid { gap: 18px; }
  .service-card {
    min-height: 286px;
    padding: 30px;
    border-color: rgba(72, 33, 45, .1);
    background: rgba(255, 255, 255, .58);
    box-shadow: 0 7px 24px rgba(72, 39, 43, .025);
  }
  .service-card:hover {
    border-color: rgba(121, 44, 66, .24);
    box-shadow: 0 22px 50px rgba(72, 39, 43, .09);
    transform: translateY(-7px);
  }
  .service-top { font-variant-numeric: tabular-nums; }
  .service-card h3 { margin-top: 37px; font-size: 29px; letter-spacing: -.025em; }
  .service-card p { font-size: 12px; line-height: 1.85; }
  .service-price { font-size: 13px; }

  .inspiration { background: linear-gradient(145deg, #f3ebe5, #f8f3ee); }
  .inspiration-grid { height: clamp(420px, 42vw, 540px); gap: 18px; }
  .inspiration-card { box-shadow: 0 14px 34px rgba(48, 35, 38, .08); }
  .inspiration-card::after { background: linear-gradient(transparent 25%, rgba(32, 18, 19, .68)); }
  .inspiration-card figcaption { right: 27px; bottom: 27px; left: 27px; }
  .inspiration-card figcaption span { letter-spacing: 2px; }
  .inspiration-card figcaption strong { font-size: 25px; }
  .inspiration-footer { margin-top: 22px; }
  .inspiration-note { font-size: 10px; }

  .about { gap: clamp(64px, 9vw, 130px); }
  .founder-card {
    min-height: 530px;
    box-shadow: 0 24px 60px rgba(48, 35, 38, .13);
  }
  .founder-card::before { inset: 16px; }
  .about-copy h2 { font-size: clamp(45px, 4.5vw, 60px); }
  .about-copy > p:not(.eyebrow) { font-size: 13px; line-height: 1.95; }
  .about-detail { margin-top: 39px; }
  .studio-photo { height: 220px; }

  .care { background: linear-gradient(145deg, #f3ebe5, #f8f4f0); }
  .care-grid { gap: 18px; }
  .care-card {
    min-height: 300px;
    padding: 29px;
    border-color: rgba(72, 33, 45, .11);
    background: rgba(252, 250, 247, .78);
  }
  .care-card h3 { font-size: 25px; letter-spacing: -.02em; }
  .care-card p { font-size: 11px; line-height: 1.9; }

  .reviews { background: radial-gradient(ellipse at 100% 0, rgba(152, 74, 91, .3), transparent 42%), var(--rose-deep); }
  .review-grid { gap: 18px; }
  .review-card { min-height: 270px; padding: 31px; box-shadow: 0 16px 40px rgba(28, 12, 18, .16); }
  .review-card blockquote { font-size: 19px; line-height: 1.55; }
  .visit { gap: 10%; }
