---
import SpeedInsights from "@vercel/speed-insights/astro";
import { Picture } from "astro:assets";
import heroNailsImage from "../assets/hero-nails.jpg";
import nailArtImage from "../assets/nail-art.jpg";
import nailColorImage from "../assets/nail-color.jpg";

const instagram = "https://www.instagram.com/valkyriasnailstudios/";
const whatsapp =
  "https://wa.me/5491140602570?text=Hola%2C%20quiero%20reservar%20un%20turno%20en%20Valkyrias%20Nails%20Studios";
const facebook = "https://www.facebook.com/valkyriasnailstudios/";
const tiktok = "https://www.tiktok.com/@valkyriasnailstudios";
const googleBusiness =
  "https://business.google.com/v/valkyrias-nails-studios/05882234067432442454/5bec/_?";
const directions =
  "https://www.google.com/maps/dir/?api=1&destination=Acoyte+81%2C+Buenos+Aires";
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const openGraphImageUrl = Astro.site
  ? new URL("/og-image.png", Astro.site).href
  : undefined;

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  name: "Valkyrias Nails Studios",
  description:
    "Salón de manicura en Caballito, Buenos Aires. Un espacio para embellecer tus manos y llevarte gratis una charla con nosotras.",
  url: canonicalUrl,
  image: openGraphImageUrl,
  telephone: "+5491140602570",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Acoyte 81",
    addressLocality: "Buenos Aires",
    addressRegion: "Ciudad Autónoma de Buenos Aires",
    postalCode: "1405",
    addressCountry: "AR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -34.62176125,
    longitude: -58.4286208,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "https://schema.org/Saturday",
      opens: "10:00",
      closes: "20:00",
    },
  ],
  areaServed: {
    "@type": "Place",
    name: "Caballito, Buenos Aires",
  },
  hasMap: "https://www.google.com/maps/place/Valkyrias+Nails+Studios/",
  sameAs: [instagram, facebook, tiktok, googleBusiness],
}).replace(/</g, "\\u003c");

const inspirationImages = [
  {
    src: heroNailsImage,
    alt: "Manicura con uñas oscuras y detalles carey",
    title: "Clásica, siempre",
    style: "inspiration-card--large",
    categories: ["nail-art", "esculpidas"],
  },
  {
    src: nailArtImage,
    alt: "Detalle de uñas con diseño de manicura",
    title: "Detalles que enamoran",
    style: "",
    categories: ["nail-art", "semipermanente"],
  },
  {
    src: nailColorImage,
    alt: "Uñas esmaltadas en tonos delicados",
    title: "Tu próximo color",
    style: "",
    categories: ["kapping", "esculpidas"],
  },
];

const inspirationFilters = [
  { id: "all", label: "Todas las ideas" },
  { id: "nail-art", label: "Nail art" },
  { id: "kapping", label: "Kapping" },
  { id: "semipermanente", label: "Semipermanente" },
  { id: "esculpidas", label: "Esculpidas" },
];

const services = [
  {
    number: "01",
    title: "Manicura",
    description:
      "Un momento para vos, con el cuidado y los detalles que tus manos merecen.",
  },
  {
    number: "02",
    title: "Uñas esculpidas",
    description:
      "Acrílico, gel o polygel: elegí tu técnica y creamos juntas el estilo que buscás.",
  },
  {
    number: "03",
    title: "Diseños y calcos",
    description:
      "Un toque de color, un detalle sutil o algo completamente único. Vos inspirás.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f4" />
    <meta
      name="description"
      content="Valkyrias Nails Studios: manicura, uñas esculpidas y diseños en Caballito, Buenos Aires. Encontranos en Acoyte 81."
    />
    <meta property="og:title" content="Valkyrias Nails Studios | Caballito" />
    <meta property="og:site_name" content="Valkyrias Nails Studios" />
    <meta
      property="og:description"
      content="Manicura, uñas esculpidas y diseños en Caballito. Un espacio para vos y tus manos."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      openGraphImageUrl && (
        <>
          <meta property="og:image" content={openGraphImageUrl} />
          <meta property="og:image:secure_url" content={openGraphImageUrl} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content="Valkyrias Nails Studios, manicura en Caballito"
          />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content="Valkyrias Nails Studios | Caballito" />
          <meta
            name="twitter:description"
            content="Manicura, uñas esculpidas y diseños en Caballito. Un espacio para vos y tus manos."
          />
          <meta name="twitter:image" content={openGraphImageUrl} />
          <meta
            name="twitter:image:alt"
            content="Valkyrias Nails Studios, manicura en Caballito"
          />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <title>Valkyrias Nails Studios | Manicura en Caballito</title>
    <script type="application/ld+json" set:html={localBusinessSchema}></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Valkyrias Nails Studios, inicio">
        <span class="brand-mark" aria-hidden="true">V</span>
        <span class="brand-name">Valkyrias <small>Nails Studios</small></span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span></span><span></span>
      </button>
      <nav class="primary-nav" id="primary-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#inspiracion">Inspiración</a>
        <a href="#nosotras">El estudio</a>
        <a href="#visitanos">Encontranos</a>
        <a class="nav-cta" href={whatsapp} target="_blank" rel="noreferrer">
          Reservá tu turno <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero section-wrap" id="inicio">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> MANICURA · CABALLITO</p>
          <h1>Manos que hablan <em>de vos.</em></h1>
          <p class="hero-description">
            Un espacio para embellecer tus manos, elegir tu próximo diseño y
            llevarte gratis una charla con nosotras.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href={whatsapp} target="_blank" rel="noreferrer">
              Quiero mi turno <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#servicios">Conocé el estudio <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof">
            <div class="rating-stars" aria-label="5 estrellas">★★★★★</div>
            <p><strong>4,9 de 5</strong><span> · 14 opiniones en Google</span></p>
          </div>
        </div>

        <div class="hero-visual reveal">
          <div class="hero-image-frame">
            <Picture
              src={heroNailsImage}
              alt="Manicura con uñas oscuras y detalles carey"
              formats={["avif", "webp"]}
              widths={[360, 640, 960]}
              sizes="(max-width: 680px) calc(100vw - 54px), (max-width: 900px) 48vw, 485px"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <div class="hero-image-shade"></div>
            <div class="image-caption">
              <span>UN RATITO PARA VOS</span>
              <span class="caption-star" aria-hidden="true">✳</span>
            </div>
          </div>
          <div class="hero-sticker" aria-label="Atención en Caballito">
            <span>HECHO CON</span>
            <strong>♡</strong>
            <span>EN CABALLITO</span>
          </div>
          <div class="hero-side-note">TU ESTILO, EN CADA DETALLE</div>
        </div>
        <a class="scroll-cue" href="#servicios"><span></span> DESLIZÁ PARA DESCUBRIR</a>
      </section>

      <div class="ticker" aria-label="Valkyrias Nails Studios, un espacio para vos">
        <div class="ticker-track" aria-hidden="true">
          {
            Array.from({ length: 4 }).map(() => (
              <span>Un espacio para vos</span>
              <i>✳</i>
              <span>Manos con personalidad</span>
              <i>✳</i>
              <span>Tu momento Valkyrias</span>
              <i>✳</i>
            ))
          }
        </div>
      </div>

      <section class="services section-wrap section-space" id="servicios">
        <div class="section-heading reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> LO QUE HACEMOS</p>
          <div class="heading-row">
            <h2>Un mimo para tus manos.<br /><em>Un plan para vos.</em></h2>
            <p class="section-intro">
              Cada visita tiene su propio ritmo. Contanos qué tenés en mente y
              lo hacemos realidad juntas.
            </p>
          </div>
        </div>
        <div class="service-grid">
          {
            services.map((service) => (
              <article class="service-card reveal">
                <div class="service-top">
                  <span>{service.number}</span>
                  <span class="service-flower" aria-hidden="true">✳</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <a href={whatsapp} target="_blank" rel="noreferrer" aria-label={`Consultar por ${service.title}`}>
                  Consultanos <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="inspiration section-space" id="inspiracion">
        <div class="section-wrap">
          <div class="section-heading inspiration-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> TU PRÓXIMA IDEA</p>
            <div class="heading-row">
              <h2>Un color, una idea.<br /><em>Algo muy tuyo.</em></h2>
              <p class="section-intro">
                Guardá tus favoritos y traelos a tu turno. Cada diseño se
                adapta a vos.
              </p>
            </div>
          </div>
          <div class="inspiration-filters" role="group" aria-label="Filtrar ideas por categoría">
            {
              inspirationFilters.map((filter, index) => (
                <button
                  class="inspiration-filter"
                  type="button"
                  data-filter={filter.id}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {filter.label}
                </button>
              ))
            }
          </div>
          <p class="gallery-status" aria-live="polite"></p>
          <div class="inspiration-grid">
            {
              inspirationImages.map((image, index) => (
                <figure
                  class={`inspiration-card ${image.style} reveal`}
                  data-categories={image.categories.join(" ")}
                >
                  <Picture
                    src={image.src}
                    alt={image.alt}
                    formats={["avif", "webp"]}
                    widths={[360, 640, 960]}
                    sizes="(max-width: 680px) calc((100vw - 50px) / 2), (max-width: 900px) 30vw, 360px"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <span>IDEA 0{index + 1}</span>
                    <strong>{image.title}</strong>
                  </figcaption>
                </figure>
              ))
            }
          </div>
          <div class="inspiration-footer">
            <p class="inspiration-note">
              Estas fotos son inspiración y no representan trabajos del estudio.
              Mirá diseños reales en nuestras redes.
            </p>
            <a class="text-link" href={instagram} target="_blank" rel="noreferrer">
              Ver Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="about section-wrap section-space" id="nosotras">
        <div class="about-art reveal" aria-hidden="true">
          <div class="about-art-backdrop"></div>
          <Picture
            src={nailColorImage}
            alt=""
            formats={["avif", "webp"]}
            widths={[360, 640, 960]}
            sizes="(max-width: 680px) calc(100vw - 54px), (max-width: 900px) 38vw, 380px"
            loading="lazy"
            decoding="async"
          />
          <span class="about-art-label">V · N · S</span>
          <span class="about-art-sparkle">✳</span>
        </div>
        <div class="about-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> MÁS QUE MANICURA</p>
          <h2>Venís por tus uñas.<br /><em>Te quedás por el momento.</em></h2>
          <p>
            Valkyrias es ese espacio donde podés bajar un cambio, sentirte
            cómoda y salir con las manos que imaginabas. Nos encanta que cada
            visita sea también una buena charla.
          </p>
          <a class="text-link" href={googleBusiness} target="_blank" rel="noreferrer">
            Conocé las opiniones en Google <span aria-hidden="true">↗</span>
          </a>
          <div class="about-detail">
            <span class="about-detail-number">4,9<span>/5</span></span>
            <span class="about-detail-copy">La experiencia Valkyrias<br />según nuestras clientas</span>
          </div>
        </div>
      </section>

      <section class="reviews section-space" id="opiniones">
        <div class="section-wrap">
          <div class="section-heading reviews-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> LO CUENTAN ELLAS</p>
            <div class="heading-row">
              <h2>Una buena experiencia<br /><em>se comparte.</em></h2>
              <div class="reviews-rating">
                <span class="reviews-stars" aria-label="5 estrellas">★★★★★</span>
                <strong>4,9 <span>/ 5</span></strong>
                <span>14 opiniones públicas en Google</span>
              </div>
            </div>
          </div>
          <div class="review-grid">
            <article class="review-card reveal">
              <span class="review-quote-mark" aria-hidden="true">“</span>
              <div class="review-stars" aria-label="5 estrellas">★★★★★</div>
              <blockquote>
                Me hago las manos hace un montón y JAMÁS me habían quedado tan
                hermosas prolijas y cuidadas. No veo la hora de mi próximo
                turno para que haga otro arte maravilloso en mis manos.
              </blockquote>
              <div class="review-credit">
                <span class="review-avatar" aria-hidden="true">F</span>
                <span><strong>Fernanda</strong><small>Opinión publicada en Google</small></span>
                <span class="google-g" aria-label="Google">G</span>
              </div>
            </article>
            <article class="review-card reveal">
              <span class="review-quote-mark" aria-hidden="true">“</span>
              <div class="review-stars" aria-label="5 estrellas">★★★★★</div>
              <blockquote>
                Las chicas al toque me dieron turno y me dejaron super bien las
                manos y los pies. Volveré.
              </blockquote>
              <div class="review-credit">
                <span class="review-avatar" aria-hidden="true">S</span>
                <span><strong>Sol</strong><small>Opinión publicada en Google</small></span>
                <span class="google-g" aria-label="Google">G</span>
              </div>
            </article>
          </div>
          <a class="reviews-link" href={googleBusiness} target="_blank" rel="noreferrer">
            Leer opiniones en Google <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="visit section-wrap section-space" id="visitanos">
        <div class="visit-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> TE ESPERAMOS</p>
          <h2>Nos encontramos<br /><em>en Caballito.</em></h2>
          <div class="visit-info">
            <div class="visit-info-icon" aria-hidden="true">⌖</div>
            <div>
              <strong>Acoyte 81</strong>
              <span>Caballito · Buenos Aires</span>
              <a href={directions} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="visit-info">
            <div class="visit-info-icon" aria-hidden="true">◷</div>
            <div>
              <strong>Sábados · 10:00 a 20:00</strong>
              <span>Atención con turno</span>
              <a href={whatsapp} target="_blank" rel="noreferrer">Consultá disponibilidad <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <a class="button button-dark visit-button" href={whatsapp} target="_blank" rel="noreferrer">
            Reservá por WhatsApp <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="map-card reveal">
          <iframe
            title="Mapa de Valkyrias Nails Studios en Acoyte 81, Caballito"
            src="https://maps.google.com/maps?q=Acoyte%2081%2C%20Caballito%2C%20Buenos%20Aires&z=15&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a class="map-label" href={directions} target="_blank" rel="noreferrer">
            <span class="map-dot"></span>
            <span><strong>Valkyrias Nails Studios</strong><small>Acoyte 81 · Caballito</small></span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="faq section-space" id="preguntas">
        <div class="section-wrap">
          <div class="section-heading faq-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> ANTES DE TU TURNO</p>
            <div class="heading-row">
              <h2>Todo claro antes<br /><em>de venir.</em></h2>
              <p class="section-intro">
                ¿Tenés otra consulta? Escribinos por Instagram y te ayudamos
                a encontrar tu momento.
              </p>
            </div>
          </div>
          <div class="faq-list">
            <details class="faq-item reveal">
              <summary>¿Con cuánta anticipación conviene reservar?</summary>
              <p>
                Los turnos son con reserva y sujetos a disponibilidad.
                Escribinos por WhatsApp o Instagram apenas tengas tu fecha en mente para
                consultar los próximos horarios.
              </p>
            </details>
            <details class="faq-item reveal">
              <summary>¿Hacen kapping y esculpidas en gel o acrílico?</summary>
              <p>
                Trabajamos uñas esculpidas en acrílico, gel y polygel.
                Consultanos por kapping y te confirmamos disponibilidad por mensaje al
                coordinar tu turno.
              </p>
            </details>
            <details class="faq-item reveal">
              <summary>¿Piden seña? ¿Cómo es la política de cancelación?</summary>
              <p>
                Las condiciones de seña, cambios y cancelaciones se confirman
                al coordinar el turno. Consultalas por mensaje antes de
                reservar por WhatsApp o Instagram.
              </p>
            </details>
            <details class="faq-item reveal">
              <summary>¿Qué medios de pago aceptan?</summary>
              <p>
                El perfil del estudio informa tarjetas Visa, Mastercard,
                American Express y Diners Club, además de pagos móviles NFC.
                Para confirmar si aceptan efectivo, Mercado Pago o
                transferencia, consultanos al reservar.
              </p>
            </details>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="final-cta-inner reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> TU MOMENTO EMPIEZA ACÁ</p>
          <h2>¿Lista para tus<br /><em>próximas uñas?</em></h2>
          <a class="button button-light" href={whatsapp} target="_blank" rel="noreferrer">
            Hablemos por WhatsApp <span aria-hidden="true">↗</span>
          </a>
          <span class="final-sparkle" aria-hidden="true">✳</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <a class="brand footer-brand" href="#inicio" aria-label="Valkyrias Nails Studios, inicio">
          <span class="brand-mark" aria-hidden="true">V</span>
          <span class="brand-name">Valkyrias <small>Nails Studios</small></span>
        </a>
        <p>Manos que hablan de vos.<br />Acoyte 81 · Caballito, Buenos Aires</p>
        <div class="social-links" aria-label="Redes sociales">
          <a href={whatsapp} target="_blank" rel="noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
          <a href={instagram} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
          <a href={facebook} target="_blank" rel="noreferrer">Facebook <span aria-hidden="true">↗</span></a>
          <a href={tiktok} target="_blank" rel="noreferrer">TikTok <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Valkyrias Nails Studios</span>
        <span>Hecho con <span class="footer-heart">♥</span> para vos</span>
        <a href={googleBusiness} target="_blank" rel="noreferrer">Ver perfil en Google <span aria-hidden="true">↗</span></a>
      </div>
    </footer>

    <a
      class="floating-booking"
      href={whatsapp}
      target="_blank"
      rel="noreferrer"
      aria-label="Reservá tu turno por WhatsApp"
    >
      <span>Reservá tu turno</span>
      <span class="floating-booking-detail">por WhatsApp</span>
      <span class="floating-booking-arrow" aria-hidden="true">↗</span>
    </a>

    <SpeedInsights />

    <script>
      document.documentElement.classList.add("js");

      const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const navigation = document.querySelector<HTMLElement>(".primary-nav");

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        menuToggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
        navigation?.classList.toggle("is-open", !isOpen);
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          menuToggle?.setAttribute("aria-label", "Abrir menú");
          navigation.classList.remove("is-open");
        });
      });

      const revealElements = document.querySelectorAll<HTMLElement>(".reveal");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const filterButtons = document.querySelectorAll<HTMLButtonElement>(".inspiration-filter");
      const inspirationCards = document.querySelectorAll<HTMLElement>(".inspiration-card");
      const galleryStatus = document.querySelector<HTMLElement>(".gallery-status");

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const selectedFilter = button.dataset.filter ?? "all";
          let visibleCards = 0;

          filterButtons.forEach((filterButton) => {
            filterButton.setAttribute(
              "aria-pressed",
              String(filterButton === button),
            );
          });

          inspirationCards.forEach((card) => {
            const categories = card.dataset.categories?.split(" ") ?? [];
            card.hidden =
              selectedFilter !== "all" && !categories.includes(selectedFilter);
            visibleCards += Number(!card.hidden);
          });

          if (galleryStatus) {
            galleryStatus.textContent = `${visibleCards} ${
              visibleCards === 1 ? "idea" : "ideas"
            } para inspirarte`;
          }
        });
      });

      if ("IntersectionObserver" in window && !reduceMotion) {
        const observer = new IntersectionObserver(
          (entries, currentObserver) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                currentObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );

        revealElements.forEach((element) => observer.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>

