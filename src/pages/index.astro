---
const instagram = "https://www.instagram.com/valkyriasnailstudios/";
const facebook = "https://www.facebook.com/valkyriasnailstudios/";
const tiktok = "https://www.tiktok.com/@valkyriasnailstudios";
const googleBusiness =
  "https://business.google.com/v/valkyrias-nails-studios/05882234067432442454/5bec/_?";
const directions =
  "https://www.google.com/maps/dir/?api=1&destination=Acoyte+81%2C+Buenos+Aires";

const inspirationImages = [
  {
    src: "https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=960&q=85",
    alt: "Manicura cuidada con esmalte rojo brillante",
    title: "Clásica, siempre",
    style: "inspiration-card--large",
  },
  {
    src: "https://images.unsplash.com/photo-1632345031435-8727f6897d53?auto=format&fit=crop&w=700&q=85",
    alt: "Detalle de uñas con diseño de manicura",
    title: "Detalles que enamoran",
    style: "",
  },
  {
    src: "https://images.unsplash.com/photo-1610992015732-2449b76344bc?auto=format&fit=crop&w=700&q=85",
    alt: "Uñas esmaltadas en tonos delicados",
    title: "Tu próximo color",
    style: "",
  },
];

const services = [
  {
    number: "01",
    title: "Manicura",
    description:
      "Un momento para vos, con el cuidado y los detalles que tus manos merecen.",
  },
  {
    number: "02",
    title: "Uñas esculpidas",
    description:
      "Acrílico, gel o polygel: elegí tu técnica y creamos juntas el estilo que buscás.",
  },
  {
    number: "03",
    title: "Diseños y calcos",
    description:
      "Un toque de color, un detalle sutil o algo completamente único. Vos inspirás.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f4" />
    <meta
      name="description"
      content="Valkyrias Nails Studios: manicura, uñas esculpidas y diseños en Caballito, Buenos Aires. Encontranos en Acoyte 81."
    />
    <meta property="og:title" content="Valkyrias Nails Studios | Caballito" />
    <meta
      property="og:description"
      content="Un espacio para embellecer tus manos y llevarte gratis una charla con nosotras."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <title>Valkyrias Nails Studios | Manicura en Caballito</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Valkyrias Nails Studios, inicio">
        <span class="brand-mark" aria-hidden="true">V</span>
        <span class="brand-name">Valkyrias <small>Nails Studios</small></span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span></span><span></span>
      </button>
      <nav class="primary-nav" id="primary-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#inspiracion">Inspiración</a>
        <a href="#nosotras">El estudio</a>
        <a href="#visitanos">Encontranos</a>
        <a class="nav-cta" href={instagram} target="_blank" rel="noreferrer">
          Reservá tu turno <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero section-wrap" id="inicio">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> MANICURA · CABALLITO</p>
          <h1>Manos que hablan <em>de vos.</em></h1>
          <p class="hero-description">
            Un espacio para embellecer tus manos, elegir tu próximo diseño y
            llevarte gratis una charla con nosotras.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href={instagram} target="_blank" rel="noreferrer">
              Quiero mi turno <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#servicios">Conocé el estudio <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof">
            <div class="rating-stars" aria-label="5 estrellas">★★★★★</div>
            <p><strong>4,9 de 5</strong><span> · 14 opiniones en Google</span></p>
          </div>
        </div>

        <div class="hero-visual reveal">
          <div class="hero-image-frame">
            <img
              src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1400&q=90"
              alt="Manicura con uñas oscuras y detalles carey"
              fetchpriority="high"
            />
            <div class="hero-image-shade"></div>
            <div class="image-caption">
              <span>UN RATITO PARA VOS</span>
              <span class="caption-star" aria-hidden="true">✳</span>
            </div>
          </div>
          <div class="hero-sticker" aria-label="Atención en Caballito">
            <span>HECHO CON</span>
            <strong>♡</strong>
            <span>EN CABALLITO</span>
          </div>
          <div class="hero-side-note">TU ESTILO, EN CADA DETALLE</div>
        </div>
        <a class="scroll-cue" href="#servicios"><span></span> DESLIZÁ PARA DESCUBRIR</a>
      </section>

      <div class="ticker" aria-label="Valkyrias Nails Studios, un espacio para vos">
        <div class="ticker-track" aria-hidden="true">
          {
            Array.from({ length: 4 }).map(() => (
              <span>Un espacio para vos</span>
              <i>✳</i>
              <span>Manos con personalidad</span>
              <i>✳</i>
              <span>Tu momento Valkyrias</span>
              <i>✳</i>
            ))
          }
        </div>
      </div>

      <section class="services section-wrap section-space" id="servicios">
        <div class="section-heading reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> LO QUE HACEMOS</p>
          <div class="heading-row">
            <h2>Un mimo para tus manos.<br /><em>Un plan para vos.</em></h2>
            <p class="section-intro">
              Cada visita tiene su propio ritmo. Contanos qué tenés en mente y
              lo hacemos realidad juntas.
            </p>
          </div>
        </div>
        <div class="service-grid">
          {
            services.map((service) => (
              <article class="service-card reveal">
                <div class="service-top">
                  <span>{service.number}</span>
                  <span class="service-flower" aria-hidden="true">✳</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <a href={instagram} target="_blank" rel="noreferrer" aria-label={`Consultar por ${service.title}`}>
                  Consultanos <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="inspiration section-space" id="inspiracion">
        <div class="section-wrap">
          <div class="section-heading inspiration-heading reveal">
            <p class="eyebrow"><span class="eyebrow-line"></span> TU PRÓXIMA IDEA</p>
            <div class="heading-row">
              <h2>Un color, una idea.<br /><em>Algo muy tuyo.</em></h2>
              <p class="section-intro">
                Guardá tus favoritos y traelos a tu turno. Cada diseño se
                adapta a vos.
              </p>
            </div>
          </div>
          <div class="inspiration-grid">
            {
              inspirationImages.map((image, index) => (
                <figure class={`inspiration-card ${image.style} reveal`}>
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <span>IDEA 0{index + 1}</span>
                    <strong>{image.title}</strong>
                  </figcaption>
                </figure>
              ))
            }
          </div>
          <p class="inspiration-note">
            Imágenes de inspiración. Consultá por tu diseño personalizado.
          </p>
        </div>
      </section>

      <section class="about section-wrap section-space" id="nosotras">
        <div class="about-art reveal" aria-hidden="true">
          <div class="about-art-backdrop"></div>
          <img
            src="https://images.unsplash.com/photo-1610992015732-2449b76344bc?auto=format&fit=crop&w=1000&q=85"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span class="about-art-label">V · N · S</span>
          <span class="about-art-sparkle">✳</span>
        </div>
        <div class="about-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> MÁS QUE MANICURA</p>
          <h2>Venís por tus uñas.<br /><em>Te quedás por el momento.</em></h2>
          <p>
            Valkyrias es ese espacio donde podés bajar un cambio, sentirte
            cómoda y salir con las manos que imaginabas. Nos encanta que cada
            visita sea también una buena charla.
          </p>
          <a class="text-link" href={googleBusiness} target="_blank" rel="noreferrer">
            Conocé las opiniones en Google <span aria-hidden="true">↗</span>
          </a>
          <div class="about-detail">
            <span class="about-detail-number">4,9<span>/5</span></span>
            <span class="about-detail-copy">La experiencia Valkyrias<br />según nuestras clientas</span>
          </div>
        </div>
      </section>

      <section class="quote-band">
        <div class="quote-inner reveal">
          <span class="quote-mark" aria-hidden="true">“</span>
          <p>Me quedaron hermosas, prolijas y cuidadas. <em>No veo la hora de volver.</em></p>
          <span class="quote-source">UNA OPINIÓN EN GOOGLE · ★★★★★</span>
        </div>
        <span class="quote-decoration quote-decoration-one" aria-hidden="true">✳</span>
        <span class="quote-decoration quote-decoration-two" aria-hidden="true">✳</span>
      </section>

      <section class="visit section-wrap section-space" id="visitanos">
        <div class="visit-copy reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> TE ESPERAMOS</p>
          <h2>Nos encontramos<br /><em>en Caballito.</em></h2>
          <div class="visit-info">
            <div class="visit-info-icon" aria-hidden="true">⌖</div>
            <div>
              <strong>Acoyte 81</strong>
              <span>Caballito · Buenos Aires</span>
              <a href={directions} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="visit-info">
            <div class="visit-info-icon" aria-hidden="true">◷</div>
            <div>
              <strong>Sábados · 10:00 a 20:00</strong>
              <span>Atención con turno</span>
              <a href={instagram} target="_blank" rel="noreferrer">Consultá disponibilidad <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <a class="button button-dark visit-button" href={instagram} target="_blank" rel="noreferrer">
            Reservá por Instagram <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="map-card reveal">
          <iframe
            title="Mapa de Valkyrias Nails Studios en Acoyte 81, Caballito"
            src="https://maps.google.com/maps?q=Acoyte%2081%2C%20Caballito%2C%20Buenos%20Aires&z=15&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a class="map-label" href={directions} target="_blank" rel="noreferrer">
            <span class="map-dot"></span>
            <span><strong>Valkyrias Nails Studios</strong><small>Acoyte 81 · Caballito</small></span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="final-cta">
        <div class="final-cta-inner reveal">
          <p class="eyebrow"><span class="eyebrow-line"></span> TU MOMENTO EMPIEZA ACÁ</p>
          <h2>¿Lista para tus<br /><em>próximas uñas?</em></h2>
          <a class="button button-light" href={instagram} target="_blank" rel="noreferrer">
            Hablemos por Instagram <span aria-hidden="true">↗</span>
          </a>
          <span class="final-sparkle" aria-hidden="true">✳</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <a class="brand footer-brand" href="#inicio" aria-label="Valkyrias Nails Studios, inicio">
          <span class="brand-mark" aria-hidden="true">V</span>
          <span class="brand-name">Valkyrias <small>Nails Studios</small></span>
        </a>
        <p>Manos que hablan de vos.<br />Acoyte 81 · Caballito, Buenos Aires</p>
        <div class="social-links" aria-label="Redes sociales">
          <a href={instagram} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
          <a href={facebook} target="_blank" rel="noreferrer">Facebook <span aria-hidden="true">↗</span></a>
          <a href={tiktok} target="_blank" rel="noreferrer">TikTok <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Valkyrias Nails Studios</span>
        <span>Hecho con <span class="footer-heart">♥</span> para vos</span>
        <a href={googleBusiness} target="_blank" rel="noreferrer">Ver perfil en Google <span aria-hidden="true">↗</span></a>
      </div>
    </footer>

    <script>
      document.documentElement.classList.add("js");

      const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const navigation = document.querySelector<HTMLElement>(".primary-nav");

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        menuToggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
        navigation?.classList.toggle("is-open", !isOpen);
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          menuToggle?.setAttribute("aria-label", "Abrir menú");
          navigation.classList.remove("is-open");
        });
      });

      const revealElements = document.querySelectorAll<HTMLElement>(".reveal");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if ("IntersectionObserver" in window && !reduceMotion) {
        const observer = new IntersectionObserver(
          (entries, currentObserver) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                currentObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );

        revealElements.forEach((element) => observer.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>

<style>
  :root {
    --ink: #302326;
    --muted: #76686a;
    --paper: #fbf8f4;
    --blush: #f0e2dc;
    --rose: #792c42;
    --rose-deep: #552130;
    --gold: #bd9161;
    --line: #e6ddd6;
    --serif: "Playfair Display", Georgia, serif;
    --sans: "DM Sans", Arial, sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 100px; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  body, button, a { -webkit-tap-highlight-color: transparent; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  .section-wrap { width: min(1200px, calc(100% - 96px)); margin-inline: auto; }
  .section-space { padding-block: 126px; }

  .site-header { position: sticky; z-index: 20; top: 0; display: flex; align-items: center; justify-content: space-between; min-height: 82px; padding: 0 max(48px, calc((100vw - 1200px) / 2)); background: rgba(251, 248, 244, .94); border-bottom: 1px solid rgba(48, 35, 38, .08); backdrop-filter: blur(16px); }
  .brand { display: inline-flex; align-items: center; gap: 11px; }
  .brand-mark { display: grid; width: 39px; height: 39px; place-items: center; border: 1px solid var(--gold); border-radius: 50%; color: var(--rose); font-family: var(--serif); font-size: 25px; font-style: italic; line-height: 1; }
  .brand-name { display: flex; flex-direction: column; font-family: var(--serif); font-size: 20px; font-weight: 600; line-height: .96; letter-spacing: -.5px; }
  .brand-name small { margin-top: 5px; color: var(--muted); font-family: var(--sans); font-size: 9px; font-weight: 500; letter-spacing: 2.8px; text-transform: uppercase; }
  .primary-nav { display: flex; align-items: center; gap: 34px; font-size: 12px; font-weight: 500; }
  .primary-nav > a:not(.nav-cta) { transition: color .2s ease; }
  .primary-nav > a:not(.nav-cta):hover, .text-link:hover { color: var(--rose); }
  .nav-cta { display: inline-flex; align-items: center; gap: 13px; padding: 13px 18px; border: 1px solid var(--rose); color: var(--rose); transition: background .2s ease, color .2s ease; }
  .nav-cta:hover { background: var(--rose); color: white; }
  .menu-toggle { display: none; }

  .hero { position: relative; display: grid; min-height: 640px; grid-template-columns: 1fr 1fr; align-items: center; gap: 7%; padding-block: 62px 84px; }
  .hero-copy { position: relative; z-index: 2; padding-bottom: 18px; }
  .eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 26px; color: var(--rose); font-size: 9px; font-weight: 700; letter-spacing: 2.15px; }
  .eyebrow-line { display: inline-block; width: 30px; height: 1px; background: var(--gold); }
  h1, h2, h3, p { margin-top: 0; }
  .hero h1 { max-width: 570px; margin-bottom: 23px; font-family: var(--serif); font-size: clamp(56px, 6.1vw, 82px); font-weight: 500; letter-spacing: -3.4px; line-height: .99; }
  h1 em, h2 em { color: var(--rose); font-weight: 500; }
  .hero-description { max-width: 410px; margin-bottom: 30px; color: var(--muted); font-size: 14px; line-height: 1.9; }
  .hero-actions { display: flex; align-items: center; gap: 25px; }
  .button { display: inline-flex; min-height: 51px; align-items: center; justify-content: center; gap: 23px; padding: 0 21px; font-size: 11px; font-weight: 600; transition: transform .25s ease, background .25s ease; }
  .button:hover { transform: translateY(-3px); }
  .button-dark { background: var(--rose); color: #fffaf6; }
  .button-dark:hover { background: var(--rose-deep); }
  .text-link { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); font-size: 11px; font-weight: 600; transition: color .2s ease; }
  .hero-proof { display: flex; align-items: center; gap: 13px; margin-top: 44px; }
  .rating-stars { color: var(--gold); font-size: 13px; letter-spacing: 2px; }
  .hero-proof p { margin: 0; color: var(--muted); font-size: 10px; }
  .hero-proof strong { color: var(--ink); font-weight: 700; }
  .hero-visual { position: relative; width: 100%; max-width: 485px; justify-self: end; padding: 0 22px 24px 0; }
  .hero-image-frame { position: relative; height: 500px; overflow: hidden; background: var(--blush); }
  .hero-image-frame::before { position: absolute; z-index: 1; inset: 12px; border: 1px solid rgba(255, 255, 255, .54); content: ""; pointer-events: none; }
  .hero-image-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-image-shade { position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgba(30, 14, 17, .45)); }
  .image-caption { position: absolute; z-index: 2; right: 33px; bottom: 32px; left: 33px; display: flex; align-items: center; justify-content: space-between; color: white; font-size: 8px; font-weight: 600; letter-spacing: 2px; }
  .caption-star { font-size: 25px; }
  .hero-sticker { position: absolute; z-index: 3; right: -15px; bottom: 62px; display: flex; width: 104px; height: 104px; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: var(--rose); color: white; box-shadow: 0 12px 30px rgba(67, 25, 38, .18); transform: rotate(9deg); }
  .hero-sticker span { font-size: 6px; font-weight: 600; letter-spacing: 1.1px; }
  .hero-sticker strong { margin: 3px 0; color: #ebcdb3; font-family: var(--serif); font-size: 29px; font-weight: 400; }
  .hero-side-note { position: absolute; top: 34px; right: -40px; color: var(--muted); font-size: 7px; letter-spacing: 1.8px; writing-mode: vertical-rl; }
  .scroll-cue { position: absolute; bottom: 28px; left: 0; display: flex; align-items: center; gap: 11px; color: var(--muted); font-size: 7px; font-weight: 600; letter-spacing: 1.7px; }
  .scroll-cue span { display: inline-block; width: 1px; height: 26px; background: var(--gold); }

  .ticker { overflow: hidden; padding-block: 20px; background: var(--rose); color: #fff8f1; }
  .ticker-track { display: flex; width: max-content; align-items: center; gap: 28px; animation: ticker-scroll 38s linear infinite; }
  .ticker-track span { font-family: var(--serif); font-size: 18px; font-style: italic; }
  .ticker-track i { color: #d5ad84; font-size: 12px; font-style: normal; }
  @keyframes ticker-scroll { to { transform: translateX(-50%); } }

  .section-heading { margin-bottom: 53px; }
  .section-heading .eyebrow { margin-bottom: 22px; }
  .heading-row { display: flex; align-items: end; justify-content: space-between; gap: 50px; }
  h2 { margin-bottom: 0; font-family: var(--serif); font-size: clamp(40px, 4.7vw, 59px); font-weight: 500; letter-spacing: -1.6px; line-height: 1.1; }
  .section-intro { max-width: 325px; margin-bottom: 5px; color: var(--muted); font-size: 12px; line-height: 1.9; }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .service-card { min-height: 255px; padding: 27px 28px; border: 1px solid var(--line); background: rgba(255, 255, 255, .38); transition: transform .3s ease, background .3s ease, box-shadow .3s ease; }
  .service-card:hover { background: #fffdfa; box-shadow: 0 18px 45px rgba(72, 39, 43, .07); transform: translateY(-5px); }
  .service-top { display: flex; align-items: center; justify-content: space-between; color: var(--gold); font-size: 10px; }
  .service-flower { font-size: 20px; }
